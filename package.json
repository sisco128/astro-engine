{
  "name": "astro-engine",
  "version": "0.1.0",
  "private": true,
  "description": "High-precision astrological calculation engine. HTTP API over Swiss Ephemeris.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.21.0 <23"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "ephem:seed": "node scripts/seed-manifest.mjs",
    "ephem:fetch": "tsx scripts/fetch-ephemeris.ts",
    "ephem:verify": "tsx scripts/verify-ephemeris.ts",
    "test": "vitest run tests/unit tests/contract --passWithNoTests",
    "test:golden": "vitest run tests/golden",
    "test:all": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/under-pressure": "^9.1.0",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.11.3",
    "geo-tz": "^8.1.8",
    "lru-cache": "^11.5.2",
    "sweph": "2.10.3-7",
    "temporal-polyfill": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.1.0"
  }
}
