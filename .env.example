NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Ephemeris ---------------------------------------------------------------

# Absolute or relative path to the directory holding the .se1 files.
# Populate it with: pnpm ephem:fetch
SE_EPHE_PATH=./ephem

# Which manifest profile to fetch and verify. All three are accepted; anything
# else throws at startup, before the server binds.
#   core   — 3 files, 1.9 MB, 1800-2399 CE. Every realistic natal chart. Fast.
#   bounds — 9 files, 7.2 MB. Core plus the edges of the measured coverage.
#            What CI installs: small enough to download on every run, complete
#            enough that the coverage suite can actually reach the bounds the
#            manifest publishes. `core` was cheaper and left that claim
#            unchecked.
#   full   — 150 files, 103 MB, 13200 BCE - 16799 CE. The default, and what
#            the Docker image ships.
EPHEMERIS_PROFILE=full

# Fail startup if any manifest file is missing or its checksum does not match.
SE_STRICT_EPHEMERIS=true

# Refuse results that silently fell back to the built-in Moshier model.
#
# Keep this on. Measured against the real files, the fallback differs from
# Swiss Ephemeris by under 1 arcsecond near the present — inside the golden
# suite's own tolerance, so no assertion on the numbers can detect it — but by
# 355 arcseconds for Mars at 3000 BCE. The returned flag is the only signal.
SE_FORBID_FALLBACK=true

# --- Limits ------------------------------------------------------------------

# Compute pool. 0 = auto (cores - 1, capped at 4).
#
# Processes, not threads: Swiss Ephemeris keeps its state in a process-global
# struct, and this project has three recorded cases of that state producing a
# plausible wrong answer. A data race on it would fail the same way — not a
# crash, just numbers.
POOL_SIZE=0
POOL_TASK_TIMEOUT_MS=60000

# Result cache. Keys carry the engine version and a hash of the ephemeris
# manifest, so a deploy or a data change invalidates everything on its own.
CACHE_MAX_ITEMS=500
CACHE_MAX_BYTES=268435456

REQUEST_TIMEOUT_MS=30000
MAX_BODY_BYTES=262144

# --- CORS / auth -------------------------------------------------------------

# Comma-separated origins. The engine is consumed by frontends in other repos,
# so this is not optional in production.
CORS_ORIGINS=http://localhost:5173

# Comma-separated API keys. Empty disables auth — development only.
API_KEYS=
RATE_LIMIT_PER_MINUTE=60

# --- AGPL compliance ---------------------------------------------------------

# Public URL of this engine's source, served by GET /v1/meta/license.
#
# AGPL-3.0 section 13 requires offering the Corresponding Source to users who
# interact with the program over a network. Publishing the repo satisfies the
# obligation; this endpoint is how a network user finds it.
SOURCE_URL=https://github.com/sisco128/astro-engine
